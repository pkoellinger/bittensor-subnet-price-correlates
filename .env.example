# Copy to .env (never commit it) or export these in your shell.

# Taostats API key (https://dash.taostats.io/api-keys). Sent as the raw
# "Authorization" header value, without "Bearer".
TAOSTATS_API_KEY=

# X API v2 app-only bearer token (pay-per-use). Only needed for
# collect/13_x_accounts.py and collect/14_kol.py.
X_BEARER_TOKEN=

# Optional. GitHub token; if empty the scripts call `gh auth token`.
GITHUB_TOKEN=

# Optional. YouTube Data API v3 key for podcast episode lists
# (collect/15_podcasts.py). Without it YouTube-only shows are read from
# data/manual/youtube_episodes.csv.
YOUTUBE_API_KEY=
